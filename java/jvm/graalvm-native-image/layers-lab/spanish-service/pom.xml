<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>bg.hristomanov.education</groupId>
        <artifactId>graalvm-layers-lab</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>spanish-service</artifactId>
    <profiles>
        <profile>
            <id>native</id>
            <dependencies>
                <dependency>
                    <groupId>bg.hristomanov.education</groupId>
                    <artifactId>graalvm-jdk-base-layer</artifactId>
                    <version>${project.version}</version>
                    <type>nil</type>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.19</version>
                        <extensions>true</extensions>
                        <configuration>
                            <mainClass>bg.hristomanov.education.graalvm.layers.SpanishService</mainClass>
                            <imageName>spanish-native</imageName>
                            <useLayers>
                                <useLayer>
                                    <artifact>bg.hristomanov.education:graalvm-jdk-base-layer</artifact>
                                </useLayer>
                            </useLayers>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-app</id>
                                <phase>package</phase>
                                <goals><goal>compile-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
