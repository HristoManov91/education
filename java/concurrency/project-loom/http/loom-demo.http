@bankApi = http://localhost:8080

# Стартирай първо bank-services и bank-api, както е описано в README.
# Всеки request има Run икона в gutter-а на IntelliJ IDEA.

### Verify that Spring handles the request on a virtual thread
# @name threadInfo
GET {{bankApi}}/api/thread-info
Accept: application/json

> {%
    client.test("Request is handled on a virtual thread", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.virtual === true, "Expected virtual=true");
    });
%}

### Run the end-to-end loan application scenario
# @name loanApplication
POST {{bankApi}}/api/loan-applications
Content-Type: application/json
Accept: application/json

{
  "customerId": "2b8d8f54-e104-4d21-97de-6ef9a78db392",
  "amount": 25000,
  "purpose": "home renovation"
}

> {%
    client.test("Demo loan application returns an approved offer", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.approved === true, "Expected approved=true");
        client.assert(response.body.customerId === "2b8d8f54-e104-4d21-97de-6ef9a78db392",
            "Unexpected customerId");
    });
%}
